<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RegistroAsistencia.ViewModels"
             x:Class="RegistroAsistencia.Views.EntregaPage"
             Title="Entregas">

    <Grid Padding="20" RowSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto">

        <Label Grid.Row="0"
               Text="{Binding Comision}"
               Style="{StaticResource TituloPagina}" />

        <Picker Grid.Row="1"
                Title="Trabajo"
                ItemsSource="{Binding Trabajos}"
                ItemDisplayBinding="{Binding Texto}"
                SelectedItem="{Binding TrabajoSeleccionado}"
                IsVisible="{Binding HayTrabajos}" />

        <Label Grid.Row="1"
               Text="Todavía no hay trabajos cargados en esta comisión."
               Style="{StaticResource TextoSecundario}"
               IsVisible="{Binding NoHayTrabajos}" />

        <Button Grid.Row="2"
                Text="Agregar trabajo"
                Command="{Binding AgregarTrabajoCommand}" />

        <Label Grid.Row="3"
               Text="{Binding Resumen}"
               Style="{StaticResource TextoSecundario}" />

        <CollectionView Grid.Row="4" ItemsSource="{Binding Filas}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,170" Padding="0,4">
                        <Label Text="{Binding Nombre}"
                               VerticalOptions="Center" />
                        <Picker Grid.Column="1"
                                ItemsSource="{x:Static vm:FilaEntrega.Opciones}"
                                SelectedItem="{Binding EstadoTexto}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="5"
               Text="{Binding Mensaje}"
               Style="{StaticResource Mensaje}" />

        <Button Grid.Row="6"
                Text="Guardar entregas"
                Command="{Binding GuardarCommand}" />

        <Button Grid.Row="7"
                Text="Cerrar entrega (los que faltan quedan como No entregado)"
                Command="{Binding CerrarEntregaCommand}" />

    </Grid>

</ContentPage>
