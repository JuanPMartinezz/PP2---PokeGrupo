<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RegistroAsistencia.Views.ReporteRiesgoPage"
             Title="Reporte de riesgo">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <Label Text="Reporte de riesgo"
                   FontSize="28"
                   FontAttributes="Bold" />

            <Label Text="{Binding Comision}"
                   FontSize="18"
                   TextColor="Gray" />

            <Border Padding="20"
                    StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="12">

                    <Label Text="Estudiantes en riesgo alto"
                           FontSize="16"
                           TextColor="Gray" />

                    <Label Text="{Binding EstudiantesEnRiesgo}"
                           FontSize="48"
                           FontAttributes="Bold"
                           TextColor="#DC6B72" />

                    <Label Text="{Binding TotalEstudiantes,
                                  StringFormat='de {0} estudiantes'}"
                           FontSize="16" />

                    <Label Text="{Binding PorcentajeEnRiesgo,
                                  StringFormat='{}{0:0.0}% de la comisión'}"
                           FontSize="18"
                           FontAttributes="Bold" />

                </VerticalStackLayout>
            </Border>

            <Border Padding="20"
                    StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="8">

                    <Label Text="Estado de la comisión"
                           FontSize="18"
                           FontAttributes="Bold" />

                    <Label Text="{Binding Resumen}"
                           FontSize="15" />

                </VerticalStackLayout>
            </Border>

            <Label Text="El reporte utiliza los resultados del cálculo de riesgo existente."
                   FontSize="12"
                   TextColor="Gray" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
