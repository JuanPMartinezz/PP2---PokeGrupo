<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="RegistroAsistencia.Views.FichaEstudiantePage"
    Title="H9 - Ficha del estudiante">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <!-- TÍTULO -->

            <Label
                Text="H9 - Ficha del estudiante"
                FontSize="24"
                FontAttributes="Bold" />

            <Label
                Text="Consultá la información académica, asistencias, entregas y riesgo del estudiante."
                TextColor="Gray" />

            <!-- COMISIÓN -->

            <Label
                Text="Comisión"
                FontAttributes="Bold" />

            <Picker
                Title="Seleccionar comisión"
                ItemsSource="{Binding Comisiones}"
                SelectedItem="{Binding ComisionSeleccionada, Mode=TwoWay}" />

            <!-- ESTUDIANTE -->

            <Label
                Text="Estudiante"
                FontAttributes="Bold" />

            <Picker
                Title="Seleccionar estudiante"
                ItemsSource="{Binding Estudiantes}"
                SelectedItem="{Binding EstudianteSeleccionado, Mode=TwoWay}" />

            <Label
                Text="{Binding Mensaje}"
                FontAttributes="Bold"
                TextColor="DarkRed" />

            <!-- DATOS DEL ESTUDIANTE -->

            <Border
                Padding="15"
                Stroke="LightGray"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="6">

                    <Label
                        Text="Datos del estudiante"
                        FontSize="19"
                        FontAttributes="Bold" />

                    <Label
                        Text="{Binding EstudianteSeleccionado.Apellido,
                        StringFormat='Apellido: {0}'}" />

                    <Label
                        Text="{Binding EstudianteSeleccionado.Nombre,
                        StringFormat='Nombre: {0}'}" />

                    <Label
                        Text="{Binding EstudianteSeleccionado.Legajo,
                        StringFormat='Legajo: {0}'}" />

                    <Label
                        Text="{Binding EstudianteSeleccionado.Comision,
                        StringFormat='Comisión: {0}'}" />

                </VerticalStackLayout>

            </Border>

            <!-- RIESGO ACADÉMICO -->

            <Border
                Padding="15"
                Stroke="DarkRed"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="6">

                    <Label
                        Text="Riesgo académico"
                        FontSize="19"
                        FontAttributes="Bold" />

                    <Label
                        Text="{Binding PorcentajeRiesgo,
                        StringFormat='{0:F2}%'}"
                        FontSize="26"
                        FontAttributes="Bold"
                        TextColor="DarkRed"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="{Binding NivelRiesgo,
                        StringFormat='Nivel de riesgo: {0}'}"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Calculado según asistencias y entregas."
                        TextColor="Gray"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </Border>

            <!-- RESUMEN ASISTENCIA -->

            <Border
                Padding="15"
                Stroke="LightGray"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Resumen de asistencia"
                        FontSize="19"
                        FontAttributes="Bold" />

                    <Grid
                        ColumnDefinitions="*,*,*"
                        ColumnSpacing="10">

                        <VerticalStackLayout
                            Grid.Column="0"
                            HorizontalOptions="Center">

                            <Label
                                Text="{Binding Presentes}"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="Green"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="Presentes"
                                HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>

                        <VerticalStackLayout
                            Grid.Column="1"
                            HorizontalOptions="Center">

                            <Label
                                Text="{Binding Ausencias}"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="Red"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="Ausencias"
                                HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>

                        <VerticalStackLayout
                            Grid.Column="2"
                            HorizontalOptions="Center">

                            <Label
                                Text="{Binding TotalClases}"
                                FontSize="22"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="Total"
                                HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>

                    </Grid>

                </VerticalStackLayout>

            </Border>

            <!-- HISTORIAL DE ASISTENCIAS -->

            <Label
                Text="Historial de asistencias"
                FontSize="19"
                FontAttributes="Bold" />

            <CollectionView
                ItemsSource="{Binding Historial}"
                HeightRequest="250">

                <CollectionView.EmptyView>

                    <Label
                        Text="El estudiante no tiene asistencias registradas."
                        TextColor="Gray"
                        HorizontalTextAlignment="Center" />

                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Margin="0,4"
                            Padding="12"
                            Stroke="LightGray"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="15">

                                <Label
                                    Grid.Column="0"
                                    Text="{Binding Clase.Fecha,
                                    StringFormat='Fecha: {0:dd/MM/yyyy}'}" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Estado}"
                                    FontAttributes="Bold" />

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>
            <!-- RESUMEN DE ENTREGAS -->

            <Border
                Padding="15"
                Stroke="LightGray"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Resumen de entregas"
                        FontSize="19"
                        FontAttributes="Bold" />

                    <Grid
                        ColumnDefinitions="*,*"
                        RowDefinitions="Auto,Auto"
                        ColumnSpacing="10"
                        RowSpacing="10">

                        <!-- ENTREGADOS -->

                        <VerticalStackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalOptions="Center">

                            <Label
                                Text="{Binding Entregados}"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="Green"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="Entregados"
                                HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>

                        <!-- NO ENTREGADOS -->

                        <VerticalStackLayout
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="Center">

                            <Label
                                Text="{Binding NoEntregados}"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="Red"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="No entregados"
                                HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>

                        <!-- FUERA DE TÉRMINO -->

                        <VerticalStackLayout
                            Grid.Row="1"
                            Grid.Column="0"
                            HorizontalOptions="Center">

                            <Label
                                Text="{Binding EntregadosFueraDeTermino}"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="Orange"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="Fuera de término"
                                HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>

                        <!-- TOTAL -->

                        <VerticalStackLayout
                            Grid.Row="1"
                            Grid.Column="1"
                            HorizontalOptions="Center">

                            <Label
                                Text="{Binding TotalEntregas}"
                                FontSize="22"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="Total"
                                HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>

                    </Grid>

                </VerticalStackLayout>

            </Border>

            <!-- HISTORIAL DE ENTREGAS -->

            <Label
                Text="Historial de entregas"
                FontSize="19"
                FontAttributes="Bold" />

            <CollectionView
                ItemsSource="{Binding HistorialEntregas}"
                HeightRequest="250">

                <CollectionView.EmptyView>

                    <Label
                        Text="El estudiante no tiene entregas registradas."
                        TextColor="Gray"
                        HorizontalTextAlignment="Center" />

                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Margin="0,4"
                            Padding="12"
                            Stroke="LightGray"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="15">

                                <Label
                                    Grid.Column="0"
                                    Text="{Binding Trabajo.Nombre}"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Estado}"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center" />

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

            <!-- HISTORIAL DE CONTACTOS -->

            <Label
                Text="Historial de contactos"
                FontSize="19"
                FontAttributes="Bold" />

            <Label
                Text="{Binding TotalContactos,
                StringFormat='Total de contactos: {0}'}"
                TextColor="Gray" />

            <CollectionView
                ItemsSource="{Binding HistorialContactos}"
                HeightRequest="250">

                <CollectionView.EmptyView>

                    <Label
                        Text="El estudiante no tiene contactos registrados."
                        TextColor="Gray"
                        HorizontalTextAlignment="Center" />

                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Margin="0,4"
                            Padding="12"
                            Stroke="LightGray"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="4">

                                <Label
                                    Text="{Binding Fecha,
                                    StringFormat='Fecha: {0:dd/MM/yyyy}'}"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding Resultado,
                                    StringFormat='Resultado: {0}'}" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>