<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RegistroAsistencia.Views.AdministrarPage"
             Title="Administrar datos"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#E9EDF5">

    <Grid RowDefinitions="Auto,*">

        <!-- ENCABEZADO -->
        <VerticalStackLayout Grid.Row="0" Spacing="0">

            <Grid BackgroundColor="#C92532"
                  Padding="24,12"
                  ColumnDefinitions="65,*,Auto"
                  ColumnSpacing="15">

                <Image Grid.Column="0"
                       Source="pokeball.png"
                       HeightRequest="58"
                       WidthRequest="58"
                       Aspect="AspectFit"
                       VerticalOptions="Center"/>

                <VerticalStackLayout Grid.Column="1"
                                     VerticalOptions="Center"
                                     Spacing="2">

                    <Label Text="Registro de asistencia"
                           FontSize="25"
                           FontAttributes="Bold"
                           TextColor="White"/>

                    <Label Text="P O K E G R U P O"
                           FontSize="10"
                           CharacterSpacing="2"
                           TextColor="#FFE2E2"/>

                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Column="2"
                                       Spacing="12"
                                       VerticalOptions="Center"
                                       Margin="10,0,8,0">

                    <Border WidthRequest="30"
                            HeightRequest="30"
                            BackgroundColor="#39C9F2"
                            Stroke="#252B35"
                            StrokeThickness="2"
                            StrokeShape="Ellipse"/>

                    <Border WidthRequest="30"
                            HeightRequest="30"
                            BackgroundColor="#FFD83D"
                            Stroke="#252B35"
                            StrokeThickness="2"
                            StrokeShape="Ellipse"/>

                    <Border WidthRequest="30"
                            HeightRequest="30"
                            BackgroundColor="#80D83C"
                            Stroke="#252B35"
                            StrokeThickness="2"
                            StrokeShape="Ellipse"/>

                </HorizontalStackLayout>

            </Grid>

            <Grid HeightRequest="8">
                <BoxView BackgroundColor="#252B35"/>
                <BoxView BackgroundColor="#E0444C"
                         HeightRequest="3"
                         VerticalOptions="End"/>
            </Grid>

        </VerticalStackLayout>

        <!-- CONTENIDO -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout Padding="20"
                                 Spacing="18">

                <!-- TITULO -->
                <HorizontalStackLayout Spacing="10"
                                       VerticalOptions="Center">

                    <Image Source="pokeball.png"
                           WidthRequest="30"
                           HeightRequest="30"
                           Aspect="AspectFit"/>

                    <Label Text="Administrar datos"
                           FontSize="25"
                           FontAttributes="Bold"
                           TextColor="#252B35"
                           VerticalOptions="Center"/>

                </HorizontalStackLayout>

                <!-- ADVERTENCIA -->
                <Border BackgroundColor="#FFF0D9"
                        Stroke="#E5B85C"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="15">

                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="12">

                        <Label Text="⚠️"
                               FontSize="25"
                               VerticalOptions="Center"/>

                        <VerticalStackLayout Grid.Column="1"
                                             VerticalOptions="Center"
                                             Spacing="3">

                            <Label Text="ATENCIÓN"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#8B5D18"/>

                            <Label Text="Las acciones de eliminación son permanentes y no se pueden deshacer."
                                   FontSize="13"
                                   TextColor="#76572B"
                                   LineBreakMode="WordWrap"/>

                        </VerticalStackLayout>

                    </Grid>

                </Border>

                <!-- COMISION -->
                <Border BackgroundColor="White"
                        Stroke="#C8D1DD"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="20">

                    <VerticalStackLayout Spacing="14">

                        <Label Text="GESTIÓN DE COMISIONES"
                               FontSize="12"
                               FontAttributes="Bold"
                               CharacterSpacing="1"
                               TextColor="#536779"/>

                        <VerticalStackLayout Spacing="7">

                            <Label Text="COMISIÓN SELECCIONADA"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#647184"/>

                            <Picker Title="Elegir comisión"
                                    ItemsSource="{Binding Comisiones}"
                                    SelectedItem="{Binding ComisionSeleccionada}"
                                    FontSize="16"
                                    TextColor="#252B35"
                                    TitleColor="#718092"/>

                        </VerticalStackLayout>

                        <BoxView HeightRequest="1"
                                 BackgroundColor="#E0E5EC"/>

                        <Button Text=" Cambiar nombre de la comisión"
                                Command="{Binding RenombrarCommand}"
                                BackgroundColor="#C92532"
                                TextColor="White"
                                CornerRadius="11"
                                HeightRequest="50"
                                FontAttributes="Bold"/>

                    </VerticalStackLayout>

                </Border>

                <!-- ACCIONES DE COMISION -->
                <Border BackgroundColor="White"
                        Stroke="#C8D1DD"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="20">

                    <VerticalStackLayout Spacing="12">

                        <Label Text="MANTENIMIENTO DE COMISIÓN"
                               FontSize="12"
                               FontAttributes="Bold"
                               CharacterSpacing="1"
                               TextColor="#536779"/>

                        <Label Text="Estas acciones afectan únicamente a la comisión seleccionada."
                               FontSize="13"
                               TextColor="#718092"/>

                        <Button Text="Vaciar comisión (borrar sus alumnos)"
                                Command="{Binding VaciarCommand}"
                                BackgroundColor="#C95B45"
                                TextColor="White"
                                CornerRadius="11"
                                HeightRequest="49"
                                FontAttributes="Bold"/>

                        <Button Text="Eliminar comisión"
                                Command="{Binding EliminarCommand}"
                                BackgroundColor="#252B35"
                                TextColor="White"
                                CornerRadius="11"
                                HeightRequest="49"
                                FontAttributes="Bold"/>

                    </VerticalStackLayout>

                </Border>

                <!-- ZONA DE PELIGRO -->
                <Border BackgroundColor="#F9E5E7"
                        Stroke="#D98A92"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 16"
                        Padding="20">

                    <VerticalStackLayout Spacing="12">

                        <Label Text="ZONA DE PELIGRO"
                               FontSize="13"
                               FontAttributes="Bold"
                               CharacterSpacing="1"
                               TextColor="#A32332"/>

                        <Label Text="Esta acción elimina todos los datos del sistema, no solamente los de una comisión."
                               FontSize="13"
                               TextColor="#71343B"
                               LineBreakMode="WordWrap"/>

                        <Button Text="⚠  Borrar todos los datos"
                                Command="{Binding BorrarTodoCommand}"
                                BackgroundColor="#A71928"
                                TextColor="White"
                                CornerRadius="11"
                                HeightRequest="52"
                                FontAttributes="Bold"/>

                    </VerticalStackLayout>

                </Border>

                <!-- MENSAJE -->
                <Label Text="{Binding Mensaje}"
                       Style="{StaticResource Mensaje}"
                       HorizontalTextAlignment="Center"/>

                <Label Text="POKEGRUPO · GESTIÓN ACADÉMICA"
                       FontSize="10"
                       CharacterSpacing="1"
                       TextColor="#8A97A8"
                       HorizontalTextAlignment="Center"/>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>

