<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RegistroAsistencia.Views.NuevaComisionPage"
             Title="Nueva comisión">

    <VerticalStackLayout Padding="20" Spacing="12">

        <Label Text="Nombre de la comisión" />
        <Entry Text="{Binding Nombre}" Placeholder="Ej.: Comisión C" />

        <Label Text="{Binding Mensaje}" Style="{StaticResource Mensaje}" />

        <Button Text="Guardar comisión" Command="{Binding GuardarCommand}" />

    </VerticalStackLayout>

</ContentPage>
