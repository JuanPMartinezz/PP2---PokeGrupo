<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RegistroAsistencia.Views.NuevaComisionPage"
             Title="Nueva comisión"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#E9EDF5">

    <Grid RowDefinitions="Auto,*">

        <!-- ENCABEZADO -->
        <VerticalStackLayout Grid.Row="0" Spacing="0">

            <Grid BackgroundColor="#C92532"
                  Padding="24,12"
                  ColumnDefinitions="65,*,Auto"
                  ColumnSpacing="15">

                <Image Grid.Column="0"
                       Source="pokeball.png"
                       HeightRequest="58"
                       WidthRequest="58"
                       Aspect="AspectFit"
                       VerticalOptions="Center"/>

                <VerticalStackLayout Grid.Column="1"
                                     VerticalOptions="Center"
                                     Spacing="2">

                    <Label Text="Registro de asistencia"
                           FontSize="25"
                           FontAttributes="Bold"
                           TextColor="White"/>

                    <Label Text="P O K E G R U P O"
                           FontSize="10"
                           CharacterSpacing="2"
                           TextColor="#FFE2E2"/>

                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Column="2"
                                       Spacing="12"
                                       VerticalOptions="Center"
                                       Margin="10,0,8,0">

                    <Border WidthRequest="30"
                            HeightRequest="30"
                            BackgroundColor="#39C9F2"
                            Stroke="#252B35"
                            StrokeThickness="2"
                            StrokeShape="Ellipse"/>

                    <Border WidthRequest="30"
                            HeightRequest="30"
                            BackgroundColor="#FFD83D"
                            Stroke="#252B35"
                            StrokeThickness="2"
                            StrokeShape="Ellipse"/>

                    <Border WidthRequest="30"
                            HeightRequest="30"
                            BackgroundColor="#80D83C"
                            Stroke="#252B35"
                            StrokeThickness="2"
                            StrokeShape="Ellipse"/>

                </HorizontalStackLayout>

            </Grid>

            <Grid HeightRequest="8">
                <BoxView BackgroundColor="#252B35"/>
                <BoxView BackgroundColor="#E0444C"
                         HeightRequest="3"
                         VerticalOptions="End"/>
            </Grid>

        </VerticalStackLayout>

        <!-- CONTENIDO -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout Padding="20"
                                 Spacing="18">

                <!-- TITULO -->
                <HorizontalStackLayout Spacing="10"
                                       VerticalOptions="Center">
                    <Image Source="pokeball.png"
                          WidthRequest="30"
                           HeightRequest="30"
                           Aspect="AspectFit"
                           VerticalOptions="Center"/>

                    <Label Text="Nueva comisión"
                           FontSize="25"
                           FontAttributes="Bold"
                           TextColor="#252B35"
                           VerticalOptions="Center"/>

                </HorizontalStackLayout>

                <!-- TARJETA -->
                <Border BackgroundColor="White"
                        Stroke="#C8D1DD"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="22">

                    <VerticalStackLayout Spacing="18">

                        <!-- CABECERA -->
                        <Grid ColumnDefinitions="*,Auto">

                            <Label Text="REGISTRO DE COMISIÓN"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1"
                                   TextColor="#536779"
                                   VerticalOptions="Center"/>

                            <Border Grid.Column="1"
                                    BackgroundColor="#C92532"
                                    Stroke="#252B35"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="10,5">

                                <Label Text="NUEVA"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="White"/>

                            </Border>

                        </Grid>

                        <!-- ICONO -->
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="15">

                            <Border WidthRequest="65"
                                    HeightRequest="65"
                                    BackgroundColor="#DCE5EC"
                                    Stroke="#252B35"
                                    StrokeThickness="2"
                                    StrokeShape="Ellipse">

                                <Image Source="pokeball.png"
                                       WidthRequest="45"
                                       HeightRequest="45"
                                       Aspect="AspectFit"/>

                            </Border>

                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="4">

                                <Label Text="Crear grupo de estudiantes"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#252B35"/>

                                <Label Text="Ingresá el nombre para identificar la comisión."
                                       FontSize="13"
                                       TextColor="#718092"
                                       LineBreakMode="WordWrap"/>

                            </VerticalStackLayout>

                        </Grid>

                        <BoxView HeightRequest="1"
                                 BackgroundColor="#E0E5EC"/>

                        <!-- NOMBRE -->
                        <VerticalStackLayout Spacing="8">

                            <Label Text="NOMBRE DE LA COMISIÓN"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1"
                                   TextColor="#536779"/>

                            <Entry Text="{Binding Nombre}"
                                   Placeholder="Ej.: Comisión C"
                                   FontSize="16"
                                   TextColor="#252B35"
                                   PlaceholderColor="#9AA6B5"
                                   BackgroundColor="#F1F4F8"
                                   HeightRequest="52"/>

                        </VerticalStackLayout>

                        <!-- MENSAJE -->
                        <Label Text="{Binding Mensaje}"
                               Style="{StaticResource Mensaje}"
                               HorizontalTextAlignment="Center"/>

                        <!-- GUARDAR -->
                        <Button Text="✓  Guardar comisión"
                                Command="{Binding GuardarCommand}"
                                BackgroundColor="#C92532"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="52"
                                FontAttributes="Bold"/>

                    </VerticalStackLayout>

                </Border>

                <Label Text="POKEGRUPO · GESTIÓN ACADÉMICA"
                       FontSize="10"
                       CharacterSpacing="1"
                       TextColor="#8A97A8"
                       HorizontalTextAlignment="Center"/>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
