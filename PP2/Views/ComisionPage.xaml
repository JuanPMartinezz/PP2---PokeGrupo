<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RegistroAsistencia.Views.ComisionPage"
             Title="{Binding Comision}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="{Binding FechaHoy}" Style="{StaticResource TituloPagina}" />
            <Label Text="{Binding ResumenAlumnos}" Style="{StaticResource TextoSecundario}" />

            <Button Text="Tomar asistencia de hoy"
                    Command="{Binding TomarAsistenciaCommand}" />
            <Label Text="{Binding EstadoAsistencia}" Style="{StaticResource TextoSecundario}" />

            <Button Text="Registrar entrega"
                    Command="{Binding RegistrarEntregaCommand}" />

            <Button Text="Ver lista de alumnos"
                    Command="{Binding VerListaCommand}" />

            <Button Text="Calendario de clases y trabajos"
                    Command="{Binding VerCalendarioCommand}" />

            <Button Text="Configurar el cálculo de riesgo"
                    Command="{Binding ConfigurarRiesgoCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
