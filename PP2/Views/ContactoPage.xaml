<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RegistroAsistencia.Views.ContactoPage"
             Title="Registrar contacto">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="{Binding Alumno}" Style="{StaticResource TituloPagina}" />

            <Label Text="Fecha del contacto" />
            <DatePicker Date="{Binding Fecha}"
                        MaximumDate="{Binding FechaMaxima}" />

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="El alumno atendió" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding Atendio}" />
            </Grid>

            <Label Text="¿Qué pasó?" />
            <Editor Text="{Binding Resultado}"
                    Placeholder="Ej.: dijo que volvía la semana próxima / sonó y no contestó"
                    AutoSize="TextChanges"
                    MinimumHeightRequest="100" />

            <Label Text="{Binding Mensaje}" Style="{StaticResource Mensaje}" />

            <Button Text="Guardar contacto" Command="{Binding GuardarCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
