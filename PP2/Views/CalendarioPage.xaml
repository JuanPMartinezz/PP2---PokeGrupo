<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RegistroAsistencia.Views.CalendarioPage"
             Title="Calendario">

    <Grid Padding="20" RowSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*">

        <Label Grid.Row="0"
               Text="{Binding Comision}"
               Style="{StaticResource TituloPagina}" />

        <Picker Grid.Row="1"
                Title="Tipo"
                ItemsSource="{Binding Tipos}"
                SelectedIndex="{Binding TipoIndice}" />

        <DatePicker Grid.Row="2" Date="{Binding Fecha}" />

        <Label Grid.Row="3"
               Text="{Binding Cuatrimestre}"
               Style="{StaticResource TextoSecundario}" />

        <Entry Grid.Row="4"
               Placeholder="Nombre del trabajo"
               Text="{Binding Descripcion}"
               IsVisible="{Binding EsTrabajo}" />

        <Button Grid.Row="5"
                Text="Agregar al calendario"
                Command="{Binding AgregarCommand}" />

        <Label Grid.Row="6"
               Text="{Binding Mensaje}"
               Style="{StaticResource Aviso}" />

        <CollectionView Grid.Row="7" ItemsSource="{Binding Actividades}" />

    </Grid>

</ContentPage>
