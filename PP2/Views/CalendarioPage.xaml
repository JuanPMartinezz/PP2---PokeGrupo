<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="RegistroAsistencia.Views.CalendarioPage"
    Title="Calendario"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#E9EDF3">

    <Grid RowDefinitions="Auto,*">

        <!-- ENCABEZADO POKEDEX -->
        <VerticalStackLayout Grid.Row="0" Spacing="0">

            <Grid
                BackgroundColor="#C92532"
                Padding="24,12"
                ColumnDefinitions="65,*,Auto"
                ColumnSpacing="15">

                <Image
                    Grid.Column="0"
                    Source="pokeball.png"
                    HeightRequest="58"
                    WidthRequest="58"
                    Aspect="AspectFit"
                    VerticalOptions="Center"/>

                <VerticalStackLayout
                    Grid.Column="1"
                    VerticalOptions="Center"
                    Spacing="2">

                    <Label
                        Text="Registro de asistencia"
                        FontSize="25"
                        FontAttributes="Bold"
                        TextColor="White"/>

                    <Label
                        Text="P O K E G R U P O"
                        FontSize="10"
                        CharacterSpacing="2"
                        TextColor="#FFE2E2"/>

                </VerticalStackLayout>

                <HorizontalStackLayout
                    Grid.Column="2"
                    Spacing="12"
                    VerticalOptions="Center"
                    Margin="10,0,8,0">

                    <Border
                        WidthRequest="30"
                        HeightRequest="30"
                        BackgroundColor="#39C9F2"
                        Stroke="#252B35"
                        StrokeThickness="2"
                        StrokeShape="Ellipse"/>

                    <Border
                        WidthRequest="30"
                        HeightRequest="30"
                        BackgroundColor="#FFD83D"
                        Stroke="#252B35"
                        StrokeThickness="2"
                        StrokeShape="Ellipse"/>

                    <Border
                        WidthRequest="30"
                        HeightRequest="30"
                        BackgroundColor="#80D83C"
                        Stroke="#252B35"
                        StrokeThickness="2"
                        StrokeShape="Ellipse"/>

                </HorizontalStackLayout>

            </Grid>

            <Grid HeightRequest="8">
                <BoxView BackgroundColor="#252B35"/>
                <BoxView
                    BackgroundColor="#E0444C"
                    HeightRequest="3"
                    VerticalOptions="End"/>
            </Grid>

        </VerticalStackLayout>

        <!-- CONTENIDO -->
        <Grid Grid.Row="1" BackgroundColor="#E9EDF3">

            <!-- POKEBALLS DECORATIVAS -->
            <Image
                Source="pokeball_fondo.png"
                HeightRequest="300"
                WidthRequest="300"
                Aspect="AspectFit"
                Opacity="1"
                HorizontalOptions="Start"
                VerticalOptions="End"
                TranslationX="-105"
                TranslationY="85"
                InputTransparent="True"/>

            <Image
                Source="pokeball_fondo.png"
                HeightRequest="300"
                WidthRequest="300"
                Aspect="AspectFit"
                Opacity="1"
                HorizontalOptions="End"
                VerticalOptions="End"
                TranslationX="105"
                TranslationY="85"
                InputTransparent="True"/>

            <ScrollView>

                <VerticalStackLayout
                    Padding="26,22,26,30"
                    Spacing="18">

                    <!-- TITULO -->
                    <HorizontalStackLayout
                        Spacing="12"
                        VerticalOptions="Center">

                        <Image
                            Source="pokeball.png"
                            HeightRequest="34"
                            WidthRequest="34"
                            Aspect="AspectFit"/>

                        <Label
                            Text="Calendario"
                            FontSize="26"
                            FontAttributes="Bold"
                            TextColor="#252B35"
                            VerticalOptions="Center"/>

                    </HorizontalStackLayout>

                    <!-- COMISION SELECCIONADA -->
                    <Border
                        BackgroundColor="White"
                        Stroke="#D5DCE5"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="16,12">

                        <VerticalStackLayout Spacing="4">

                            <Label
                                Text="COMISIÓN ACTUAL"
                                FontSize="11"
                                CharacterSpacing="1.5"
                                FontAttributes="Bold"
                                TextColor="#D9363E"/>

                            <Label
                                Text="{Binding Comision}"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="#252B35"/>

                        </VerticalStackLayout>

                    </Border>

                    <!-- CARGAR TRABAJO -->
                    <Border
                        BackgroundColor="White"
                        Stroke="#D5DCE5"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="18">

                        <VerticalStackLayout Spacing="12">

                            <Label
                                Text="＋  Nuevo trabajo"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="#252B35"/>

                            <Label
                                Text="Nombre del trabajo"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#687383"/>

                            <Entry
                                Placeholder="Ej. Trabajo práctico 1"
                                Text="{Binding Descripcion}"
                                BackgroundColor="#F5F6F8"
                                TextColor="#252B35"
                                PlaceholderColor="#9299A5"
                                HeightRequest="48"/>

                            <Label
                                Text="Fecha de entrega"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#687383"/>

                            <Border
                                BackgroundColor="#F5F6F8"
                                Stroke="#E0E3E8"
                                StrokeShape="RoundRectangle 10"
                                Padding="8">

                                <DatePicker
                                    Date="{Binding Fecha}"
                                    TextColor="#252B35"
                                    BackgroundColor="Transparent"/>

                            </Border>

                            <Label
                                Text="{Binding Cuatrimestre}"
                                FontSize="13"
                                TextColor="#687383"/>

                            <Button
                                Text="＋   Agregar trabajo"
                                Command="{Binding AgregarCommand}"
                                BackgroundColor="#D9363E"
                                TextColor="White"
                                FontSize="15"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HeightRequest="48"
                                BorderColor="#991F29"
                                BorderWidth="1"/>

                            <Label
                                Text="{Binding Mensaje}"
                                TextColor="#D9363E"
                                FontSize="13"/>

                        </VerticalStackLayout>

                    </Border>

                    <!-- LISTA DE TRABAJOS -->
                    <Border
                        BackgroundColor="White"
                        Stroke="#D5DCE5"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="16">

                        <VerticalStackLayout Spacing="12">

                            <HorizontalStackLayout
                                Spacing="10"
                                VerticalOptions="Center">

                                <Label
                                    Text="▤"
                                    FontSize="24"
                                    TextColor="#D9363E"/>

                                <Label
                                    Text="Trabajos"
                                    FontSize="21"
                                    FontAttributes="Bold"
                                    TextColor="#252B35"
                                    VerticalOptions="Center"/>

                            </HorizontalStackLayout>

                            <BoxView
                                HeightRequest="1"
                                BackgroundColor="#E0E3E8"/>

                            <CollectionView
                                ItemsSource="{Binding Actividades}"
                                HeightRequest="180"
                                SelectionMode="None">

                                <CollectionView.EmptyView>
                                    <Label
                                        Text="Todavía no hay trabajos registrados."
                                        FontSize="14"
                                        TextColor="#9299A5"
                                        Padding="8"/>
                                </CollectionView.EmptyView>

                            </CollectionView>

                        </VerticalStackLayout>

                    </Border>

                    <!-- CLASES DICTADAS -->
                    <Border
                        BackgroundColor="White"
                        Stroke="#D5DCE5"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="16">

                        <VerticalStackLayout Spacing="12">

                            <HorizontalStackLayout
                                Spacing="10"
                                VerticalOptions="Center">

                                <Label
                                    Text="▦"
                                    FontSize="24"
                                    TextColor="#D9363E"/>

                                <Label
                                    Text="Clases dictadas"
                                    FontSize="21"
                                    FontAttributes="Bold"
                                    TextColor="#252B35"
                                    VerticalOptions="Center"/>

                            </HorizontalStackLayout>

                            <Label
                                Text="Según la asistencia tomada"
                                FontSize="13"
                                TextColor="#687383"/>

                            <BoxView
                                HeightRequest="1"
                                BackgroundColor="#E0E3E8"/>

                            <CollectionView
                                ItemsSource="{Binding Clases}"
                                HeightRequest="180"
                                SelectionMode="None">

                                <CollectionView.EmptyView>
                                    <Label
                                        Text="Todavía no hay clases registradas."
                                        FontSize="14"
                                        TextColor="#9299A5"
                                        Padding="8"/>
                                </CollectionView.EmptyView>

                            </CollectionView>

                        </VerticalStackLayout>

                    </Border>

                </VerticalStackLayout>

            </ScrollView>

        </Grid>

    </Grid>

</ContentPage>
