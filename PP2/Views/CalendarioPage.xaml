<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RegistroAsistencia.Views.CalendarioPage"
             Title="Calendario">

    <Grid Padding="20" RowSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,*">

        <Label Grid.Row="0"
               Text="{Binding Comision}"
               Style="{StaticResource TituloPagina}" />

        <Entry Grid.Row="1"
               Placeholder="Nombre del trabajo"
               Text="{Binding Descripcion}" />

        <DatePicker Grid.Row="2" Date="{Binding Fecha}" />

        <Label Grid.Row="3"
               Text="{Binding Cuatrimestre}"
               Style="{StaticResource TextoSecundario}" />

        <Button Grid.Row="4"
                Text="Agregar trabajo"
                Command="{Binding AgregarCommand}" />

        <Label Grid.Row="5"
               Text="{Binding Mensaje}"
               Style="{StaticResource Mensaje}" />

        <Label Grid.Row="6"
               Text="Trabajos"
               FontAttributes="Bold" />

        <CollectionView Grid.Row="7" ItemsSource="{Binding Actividades}" />

        <Label Grid.Row="8"
               Text="Clases dictadas (según la asistencia tomada)"
               FontAttributes="Bold" />

        <CollectionView Grid.Row="9" ItemsSource="{Binding Clases}" />

    </Grid>

</ContentPage>
