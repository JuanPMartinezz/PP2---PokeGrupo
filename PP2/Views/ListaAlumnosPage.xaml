<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:modelos="clr-namespace:RegistroAsistencia.Models"
    x:Class="RegistroAsistencia.Views.ListaAlumnosPage"
    Title="Alumnos"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#E9EDF3">

    <Grid RowDefinitions="Auto,*">

        <!-- ENCABEZADO POKEDEX -->
        <VerticalStackLayout Grid.Row="0" Spacing="0">

            <Grid
                BackgroundColor="#C92532"
                Padding="24,12"
                ColumnDefinitions="65,*,Auto"
                ColumnSpacing="15">

                <Image
                    Grid.Column="0"
                    Source="pokeball.png"
                    HeightRequest="58"
                    WidthRequest="58"
                    Aspect="AspectFit"
                    VerticalOptions="Center"/>

                <VerticalStackLayout
                    Grid.Column="1"
                    VerticalOptions="Center"
                    Spacing="2">

                    <Label
                        Text="Registro de asistencia"
                        FontSize="25"
                        FontAttributes="Bold"
                        TextColor="White"/>

                    <Label
                        Text="P O K E G R U P O"
                        FontSize="10"
                        CharacterSpacing="2"
                        TextColor="#FFE2E2"/>

                </VerticalStackLayout>

                <HorizontalStackLayout
                    Grid.Column="2"
                    Spacing="12"
                    VerticalOptions="Center"
                    Margin="10,0,8,0">

                    <Border
                        WidthRequest="30"
                        HeightRequest="30"
                        BackgroundColor="#39C9F2"
                        Stroke="#252B35"
                        StrokeThickness="2"
                        StrokeShape="Ellipse"/>

                    <Border
                        WidthRequest="30"
                        HeightRequest="30"
                        BackgroundColor="#FFD83D"
                        Stroke="#252B35"
                        StrokeThickness="2"
                        StrokeShape="Ellipse"/>

                    <Border
                        WidthRequest="30"
                        HeightRequest="30"
                        BackgroundColor="#80D83C"
                        Stroke="#252B35"
                        StrokeThickness="2"
                        StrokeShape="Ellipse"/>

                </HorizontalStackLayout>

            </Grid>

            <Grid HeightRequest="8">
                <BoxView BackgroundColor="#252B35"/>
                <BoxView
                    BackgroundColor="#E0444C"
                    HeightRequest="3"
                    VerticalOptions="End"/>
            </Grid>

        </VerticalStackLayout>

        <!-- CONTENIDO -->
        <Grid Grid.Row="1" BackgroundColor="#E9EDF3">

            <!-- POKEBALLS DECORATIVAS -->
            <Image
                Source="pokeball_fondo.png"
                HeightRequest="300"
                WidthRequest="300"
                Aspect="AspectFit"
                Opacity="1"
                HorizontalOptions="Start"
                VerticalOptions="End"
                TranslationX="-105"
                TranslationY="85"
                InputTransparent="True"/>

            <Image
                Source="pokeball_fondo.png"
                HeightRequest="300"
                WidthRequest="300"
                Aspect="AspectFit"
                Opacity="1"
                HorizontalOptions="End"
                VerticalOptions="End"
                TranslationX="105"
                TranslationY="85"
                InputTransparent="True"/>

            <ScrollView>

                <VerticalStackLayout
                    Padding="24,20,24,28"
                    Spacing="18">

                    <!-- TITULO -->
                    <HorizontalStackLayout
                        Spacing="12"
                        VerticalOptions="Center">

                        <Image
                            Source="pokeball.png"
                            HeightRequest="34"
                            WidthRequest="34"
                            Aspect="AspectFit"/>

                        <Label
                            Text="Lista de alumnos"
                            FontSize="26"
                            FontAttributes="Bold"
                            TextColor="#252B35"
                            VerticalOptions="Center"/>

                    </HorizontalStackLayout>

                    <!-- FILTROS -->
                    <Border
                        BackgroundColor="White"
                        Stroke="#D5DCE5"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="18">

                        <VerticalStackLayout Spacing="12">

                            <Label
                                Text="BUSCAR Y FILTRAR"
                                FontSize="12"
                                CharacterSpacing="1.5"
                                FontAttributes="Bold"
                                TextColor="#D9363E"/>

                            <!-- COMISION -->
                            <Label
                                Text="Comisión"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#687383"/>

                            <Picker
                                Title="Elegí una comisión"
                                ItemsSource="{Binding Comisiones}"
                                SelectedItem="{Binding ComisionSeleccionada}"
                                TextColor="#252B35"
                                BackgroundColor="#F5F6F8"/>

                            <BoxView
                                HeightRequest="1"
                                BackgroundColor="#E0E3E8"/>

                            <!-- ORDEN -->
                            <Label
                                Text="Ordenar alumnos"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#687383"/>

                            <Picker
                                Title="Orden"
                                ItemsSource="{Binding Ordenes}"
                                SelectedIndex="{Binding OrdenIndice}"
                                TextColor="#252B35"
                                BackgroundColor="#F5F6F8"/>

                            <!-- CONTACTO -->
                            <Label
                                Text="Estado de contacto"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#687383"/>

                            <Picker
                                Title="Contacto"
                                ItemsSource="{Binding FiltrosContacto}"
                                SelectedIndex="{Binding ContactoIndice}"
                                TextColor="#252B35"
                                BackgroundColor="#F5F6F8"/>

                            <!-- RIESGO -->
                            <Label
                                Text="Nivel de riesgo"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#687383"/>

                            <Picker
                                Title="Todos los niveles"
                                ItemsSource="{Binding FiltrosNivel}"
                                SelectedIndex="{Binding NivelIndice}"
                                TextColor="#252B35"
                                BackgroundColor="#F5F6F8"/>

                            <BoxView
                                HeightRequest="1"
                                BackgroundColor="#E0E3E8"/>

                            <!-- CARGA MASIVA -->
                            <Button
                                Text="Importar alumnos desde CSV"
                                Command="{Binding ImportarAlumnosCommand}"
                                BackgroundColor="#C92532"
                                TextColor="White"
                                CornerRadius="12"/>

                        </VerticalStackLayout>

                    </Border>

                    <!-- RESUMEN -->
                    <Border
                        BackgroundColor="#FFFFFF"
                        Stroke="#D5DCE5"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="14,12">

                        <HorizontalStackLayout Spacing="10">

                            <Image
                                Source="pokeball.png"
                                HeightRequest="25"
                                WidthRequest="25"
                                Aspect="AspectFit"/>

                            <Label
                                Text="{Binding Resumen}"
                                FontSize="14"
                                TextColor="#596575"
                                VerticalOptions="Center"/>

                        </HorizontalStackLayout>

                    </Border>

                    <!-- LISTADO -->
                    <HorizontalStackLayout
                        Spacing="10"
                        VerticalOptions="Center">

                        <Label Text="⚡"
                          FontSize="22"
                          TextColor="#F5C928"
                          VerticalOptions="Center" />

                        <Label
                            Text="Alumnos registrados"
                            FontSize="21"
                            FontAttributes="Bold"
                            TextColor="#252B35"
                            VerticalOptions="Center"/>

                    </HorizontalStackLayout>

                    <CollectionView
                        ItemsSource="{Binding Alumnos}"
                        SelectionMode="None">

                        <CollectionView.EmptyView>
                            <Border
                                BackgroundColor="White"
                                Stroke="#D5DCE5"
                                StrokeShape="RoundRectangle 12"
                                Padding="18">

                                <Label
                                    Text="No hay alumnos para mostrar con estos filtros."
                                    FontSize="14"
                                    TextColor="#687383"
                                    HorizontalTextAlignment="Center"/>

                            </Border>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <Border
                                    BackgroundColor="White"
                                    Stroke="#D5DCE5"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 13"
                                    Padding="0"
                                    Margin="0,0,0,10">

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Abrir}"/>
                                    </Border.GestureRecognizers>

                                    <Grid
                                        ColumnDefinitions="6,55,*"
                                        Padding="0"
                                        MinimumHeightRequest="85">

                                        <!-- FRANJA -->
                                        <BoxView
                                            Grid.Column="0"
                                            BackgroundColor="#D9363E"/>

                                        <!-- ICONO -->
                                        <Image
                                            Grid.Column="1"
                                            Source="pokeball.png"
                                            HeightRequest="35"
                                            WidthRequest="35"
                                            Aspect="AspectFit"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Center"/>

                                        <!-- INFORMACION -->
                                        <Grid
                                            Grid.Column="2"
                                            Padding="12,12,14,12"
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="8">

                                            <VerticalStackLayout
                                                Grid.Column="0"
                                                VerticalOptions="Center"
                                                Spacing="5">

                                                <Label
                                                    Text="{Binding Nombre}"
                                                    FontSize="17"
                                                    FontAttributes="Bold"
                                                    TextColor="#252B35"/>

                                                <Label
                                                    Text="Ver ficha del alumno"
                                                    FontSize="12"
                                                    TextColor="#687383"/>

                                            </VerticalStackLayout>

                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                VerticalOptions="Center"
                                                HorizontalOptions="End"
                                                Spacing="5">

                                                <Label
                                                    Text="{Binding Riesgo}"
                                                    FontSize="13"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource RiesgoSinDatos}"
                                                    HorizontalTextAlignment="End">

                                                    <Label.Triggers>

                                                        <DataTrigger
                                                            TargetType="Label"
                                                            Binding="{Binding Nivel}"
                                                            Value="{x:Static modelos:NivelesRiesgo.Alto}">

                                                            <Setter
                                                                Property="TextColor"
                                                                Value="{StaticResource RiesgoAlto}"/>

                                                        </DataTrigger>

                                                        <DataTrigger
                                                            TargetType="Label"
                                                            Binding="{Binding Nivel}"
                                                            Value="{x:Static modelos:NivelesRiesgo.Medio}">

                                                            <Setter
                                                                Property="TextColor"
                                                                Value="{StaticResource RiesgoMedio}"/>

                                                        </DataTrigger>

                                                        <DataTrigger
                                                            TargetType="Label"
                                                            Binding="{Binding Nivel}"
                                                            Value="{x:Static modelos:NivelesRiesgo.Bajo}">

                                                            <Setter
                                                                Property="TextColor"
                                                                Value="{StaticResource RiesgoBajo}"/>

                                                        </DataTrigger>

                                                    </Label.Triggers>

                                                </Label>

                                                <Label
                                                    Text="¡Contactar!"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource RiesgoAlto}"
                                                    IsVisible="{Binding Llamar}"
                                                    HorizontalTextAlignment="End"/>

                                            </VerticalStackLayout>

                                        </Grid>

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </VerticalStackLayout>

            </ScrollView>

        </Grid>

    </Grid>

</ContentPage>

