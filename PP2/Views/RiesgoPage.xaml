<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="RegistroAsistencia.Views.RiesgoPage">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="10">

            <Label
                Text="H8 - Panel de riesgo"
                FontSize="24"
                FontAttributes="Bold" />

            <CollectionView
                ItemsSource="{Binding Resultados}">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Frame
                            Padding="10"
                            Margin="0,5">

                            <VerticalStackLayout>

                                <Label
                                    Text="{Binding Estudiante}"
                                    FontAttributes="Bold" />

                                <Label
    Text="{Binding Ausencias,
    StringFormat='Ausencias: {0}'}" />

                                    <Label
    Text="{Binding Presentes,
    StringFormat='Presentes: {0}'}" />

                                    <Label
    Text="{Binding TotalClases,
    StringFormat='Total clases: {0}'}" />

                                    <Label
    Text="{Binding PorcentajeAusencias,
    StringFormat='Riesgo: {0:F0}%'}"
    FontAttributes="Bold" />

                            </VerticalStackLayout>

                        </Frame>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>