<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="RegistroAsistencia.Views.RiesgoPage"
    Title="H8 - Panel de riesgo">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="12">

            <!-- Título -->

            <Label
                Text="H8 - Panel de riesgo"
                FontSize="24"
                FontAttributes="Bold" />

            <Label
                Text="Ranking de estudiantes según su riesgo académico."
                TextColor="Gray" />

            <!-- Comisión -->

            <Label
                Text="Comisión"
                FontAttributes="Bold" />

            <Picker
                Title="Seleccionar comisión"
                ItemsSource="{Binding Comisiones}"
                SelectedItem="{Binding ComisionSeleccionada, Mode=TwoWay}" />

            <Label
                Text="Mostrar"
                FontAttributes="Bold" />

            <Picker
                Title="Filtrar por contacto"
                ItemsSource="{Binding FiltrosContacto}"
                SelectedItem="{Binding FiltroContactoSeleccionado, Mode=TwoWay}" />

            <Label
                Text="{Binding ComisionSeleccionada,
                StringFormat='Ranking - {0}'}"
                FontSize="20"
                FontAttributes="Bold"
                Margin="0,10,0,0" />

            <Label
                Text="{Binding ResumenContactos}"
                FontAttributes="Bold" />

            <Label
                Text="{Binding ResumenMostrados}"
                TextColor="Gray" />

            <!-- Ranking -->

            <CollectionView
                ItemsSource="{Binding Resultados}"
                SelectionMode="None"
                HeightRequest="600">

                <CollectionView.EmptyView>

                    <VerticalStackLayout
                        Padding="20"
                        Spacing="5">

                        <Label
                            Text="No hay estudiantes para mostrar."
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Probá con otro filtro o registrá estudiantes en esta comisión."
                            TextColor="Gray"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Padding="15"
                            Margin="0,6"
                            Stroke="LightGray"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>

                            <VerticalStackLayout
                                Spacing="8">

                                <!-- Estudiante -->

                                <Label
                                    Text="{Binding Estudiante}"
                                    FontSize="18"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding Estudiante.Legajo,
                                    StringFormat='Legajo: {0}'}"
                                    TextColor="Gray" />

                                <!-- Riesgo combinado -->

                                <Label
                                    Text="{Binding PorcentajeRiesgo,
                                    StringFormat='Riesgo académico: {0:F2}%'}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="DarkRed" />

                                <Label
                                    Text="{Binding NivelRiesgo,
                                    StringFormat='Nivel de riesgo: {0}'}"
                                    FontAttributes="Bold" />

                                <!-- Contactos (H11) -->

                                <Label
                                    Text="{Binding EstadoContacto}"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding UltimoContactoTexto}"
                                    TextColor="Gray" />

                                <Label
                                    Text="{Binding CantidadContactos,
                                    StringFormat='Cantidad de contactos: {0}'}"
                                    TextColor="Gray" />

                                <VerticalStackLayout
                                    BindableLayout.ItemsSource="{Binding Contactos}">

                                    <BindableLayout.ItemTemplate>

                                        <DataTemplate>

                                            <VerticalStackLayout
                                                Margin="0,2">

                                                <Label
                                                    Text="{Binding Fecha,
                                                    StringFormat='{0:dd/MM/yyyy}'}"
                                                    FontSize="12"
                                                    FontAttributes="Bold" />

                                                <Label
                                                    Text="{Binding Resultado}"
                                                    FontSize="12"
                                                    TextColor="Gray" />

                                            </VerticalStackLayout>

                                        </DataTemplate>

                                    </BindableLayout.ItemTemplate>

                                </VerticalStackLayout>

                                <!-- Asistencias -->

                                <Label
                                    Text="Asistencias"
                                    FontAttributes="Bold"
                                    Margin="0,5,0,0" />

                                <Grid
                                    ColumnDefinitions="*,*,*"
                                    ColumnSpacing="10">

                                    <VerticalStackLayout
                                        Grid.Column="0">

                                        <Label
                                            Text="Presentes"
                                            FontSize="12"
                                            TextColor="Gray" />

                                        <Label
                                            Text="{Binding Presentes}"
                                            FontAttributes="Bold" />

                                    </VerticalStackLayout>

                                    <VerticalStackLayout
                                        Grid.Column="1">

                                        <Label
                                            Text="Ausencias"
                                            FontSize="12"
                                            TextColor="Gray" />

                                        <Label
                                            Text="{Binding Ausencias}"
                                            FontAttributes="Bold" />

                                    </VerticalStackLayout>

                                    <VerticalStackLayout
                                        Grid.Column="2">

                                        <Label
                                            Text="Total"
                                            FontSize="12"
                                            TextColor="Gray" />

                                        <Label
                                            Text="{Binding TotalClases}"
                                            FontAttributes="Bold" />

                                    </VerticalStackLayout>

                                </Grid>

                                <!-- Entregas -->

                                <Label
                                    Text="Entregas"
                                    FontAttributes="Bold"
                                    Margin="0,5,0,0" />

                                <Grid
                                    ColumnDefinitions="*,*"
                                    RowDefinitions="Auto,Auto"
                                    ColumnSpacing="10"
                                    RowSpacing="8">

                                    <VerticalStackLayout
                                        Grid.Row="0"
                                        Grid.Column="0">

                                        <Label
                                            Text="Entregados"
                                            FontSize="12"
                                            TextColor="Gray" />

                                        <Label
                                            Text="{Binding Entregados}"
                                            FontAttributes="Bold" />

                                    </VerticalStackLayout>

                                    <VerticalStackLayout
                                        Grid.Row="0"
                                        Grid.Column="1">

                                        <Label
                                            Text="No entregados"
                                            FontSize="12"
                                            TextColor="Gray" />

                                        <Label
                                            Text="{Binding NoEntregados}"
                                            FontAttributes="Bold" />

                                    </VerticalStackLayout>

                                    <VerticalStackLayout
                                        Grid.Row="1"
                                        Grid.Column="0">

                                        <Label
                                            Text="Fuera de término"
                                            FontSize="12"
                                            TextColor="Gray" />

                                        <Label
                                            Text="{Binding EntregadosFueraDeTermino}"
                                            FontAttributes="Bold" />

                                    </VerticalStackLayout>

                                    <VerticalStackLayout
                                        Grid.Row="1"
                                        Grid.Column="1">

                                        <Label
                                            Text="Total"
                                            FontSize="12"
                                            TextColor="Gray" />

                                        <Label
                                            Text="{Binding TotalEntregas}"
                                            FontAttributes="Bold" />

                                    </VerticalStackLayout>

                                </Grid>

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>