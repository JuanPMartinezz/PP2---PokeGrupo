<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RegistroAsistencia.Views.AsistenciaPage"
             Title="Asistencia">

    <Grid Padding="20" RowSpacing="10" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

        <Label Grid.Row="0"
               Text="{Binding Comision}"
               Style="{StaticResource TituloPagina}" />

        <DatePicker Grid.Row="1"
                    Date="{Binding Fecha}"
                    MaximumDate="{Binding FechaMaxima}" />

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <Label Text="{Binding Resumen}"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="Marcar todos presentes"
                    Command="{Binding MarcarTodosCommand}" />
        </Grid>

        <CollectionView Grid.Row="3" ItemsSource="{Binding Filas}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*" Padding="0,4">
                        <CheckBox IsChecked="{Binding Presente}" />
                        <Label Grid.Column="1"
                               Text="{Binding Nombre}"
                               VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="4"
               Text="{Binding Mensaje}"
               Style="{StaticResource Aviso}" />

        <Button Grid.Row="5"
                Text="Guardar asistencia"
                Command="{Binding GuardarCommand}" />

    </Grid>

</ContentPage>
