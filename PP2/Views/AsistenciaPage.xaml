<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RegistroAsistencia.Views.AsistenciaPage"
             Title="Asistencia"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#E9EDF5">

    <Grid RowDefinitions="Auto,*">

        <!-- ENCABEZADO POKEDEX -->
        <VerticalStackLayout Grid.Row="0" Spacing="0">

            <Grid
         BackgroundColor="#C92532"
         Padding="24,12"
         ColumnDefinitions="65,*,Auto"
         ColumnSpacing="15">

                <Image
             Grid.Column="0"
             Source="pokeball.png"
             HeightRequest="58"
             WidthRequest="58"
             Aspect="AspectFit"
             VerticalOptions="Center"/>

                <VerticalStackLayout
             Grid.Column="1"
             VerticalOptions="Center"
             Spacing="2">

                    <Label
                 Text="Registro de asistencia"
                 FontSize="25"
                 FontAttributes="Bold"
                 TextColor="White"/>

                    <Label
                 Text="P O K E G R U P O"
                 FontSize="10"
                 CharacterSpacing="2"
                 TextColor="#FFE2E2"/>

                </VerticalStackLayout>

                <HorizontalStackLayout
             Grid.Column="2"
             Spacing="12"
             VerticalOptions="Center"
             Margin="10,0,8,0">

                    <Border
                 WidthRequest="30"
                 HeightRequest="30"
                 BackgroundColor="#39C9F2"
                 Stroke="#252B35"
                 StrokeThickness="2"
                 StrokeShape="Ellipse"/>

                    <Border
                 WidthRequest="30"
                 HeightRequest="30"
                 BackgroundColor="#FFD83D"
                 Stroke="#252B35"
                 StrokeThickness="2"
                 StrokeShape="Ellipse"/>

                    <Border
                 WidthRequest="30"
                 HeightRequest="30"
                 BackgroundColor="#80D83C"
                 Stroke="#252B35"
                 StrokeThickness="2"
                 StrokeShape="Ellipse"/>

                </HorizontalStackLayout>

            </Grid>

            <Grid HeightRequest="8">
                <BoxView BackgroundColor="#252B35"/>
                <BoxView
             BackgroundColor="#E0444C"
             HeightRequest="3"
             VerticalOptions="End"/>
            </Grid>

        </VerticalStackLayout>

        <!-- CONTENIDO -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout Padding="20"
                                 Spacing="14">

                <!-- TÍTULO -->
                <Label Text="💧   Tomar asistencia"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="#30343B" />

                <!-- COMISIÓN -->
                <Border BackgroundColor="White"
                        Stroke="#DDE1E7"
                        StrokeThickness="1"
                        Padding="18"
                        StrokeShape="RoundRectangle 14">

                    <VerticalStackLayout Spacing="12">

                        <Label Text="COMISIÓN ACTUAL"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#D9363E" />

                        <Label Text="{Binding Comision}"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#30343B" />

                        <BoxView HeightRequest="1"
                                 Color="#E0E3E8" />

                        <Label Text="Fecha de la clase"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#68778F" />

                        <DatePicker Date="{Binding Fecha}"
                                    MaximumDate="{Binding FechaMaxima}"
                                    HorizontalOptions="Start"
                                    TextColor="#30343B" />

                    </VerticalStackLayout>
                </Border>

                <!-- RESUMEN -->
                <Border BackgroundColor="White"
                        Stroke="#DDE1E7"
                        StrokeThickness="1"
                        Padding="14"
                        StrokeShape="RoundRectangle 14">

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="10">

                        <VerticalStackLayout Spacing="4">

                            <Label Text="Registro de alumnos"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#30343B" />

                            <Label Text="{Binding Resumen}"
                                   FontSize="13"
                                   TextColor="#68778F" />

                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="Todos presentes"
                                Command="{Binding MarcarTodosCommand}"
                                BackgroundColor="#D9363E"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="12"
                                CornerRadius="12"
                                Padding="12,8"
                                VerticalOptions="Center" />

                    </Grid>
                </Border>

                <!-- ALUMNOS -->
                <CollectionView ItemsSource="{Binding Filas}"
                                SelectionMode="None">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border BackgroundColor="White"
                                    Stroke="#DDE1E7"
                                    StrokeThickness="1"
                                    Padding="14"
                                    Margin="0,0,0,8"
                                    StrokeShape="RoundRectangle 14">

                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="14">

                                    <CheckBox IsChecked="{Binding Presente}"
                                              Color="#D9363E"
                                              VerticalOptions="Center" />

                                    <VerticalStackLayout Grid.Column="1"
                                                         VerticalOptions="Center"
                                                         Spacing="3">

                                        <Label Text="{Binding Nombre}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#30343B" />

                                        <Label Text="Registro de asistencia"
                                               FontSize="11"
                                               TextColor="#8490A3" />

                                    </VerticalStackLayout>

                                    <Label Grid.Column="2"
                                           Text="{Binding IconoRiesgo}"
                                           FontSize="25"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Center" />

                                </Grid>
                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- LEYENDA -->
                <Border BackgroundColor="White"
                        Stroke="#DDE1E7"
                        StrokeThickness="1"
                        Padding="16"
                        StrokeShape="RoundRectangle 14">

                    <VerticalStackLayout Spacing="12">

                        <Label Text="REFERENCIA DE RIESGO"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#30343B" />

                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="12"
                              RowSpacing="14">

                            <HorizontalStackLayout Spacing="8">
                                <Label Text="🔴"
                                       FontSize="22" />
                                <Label Text="Riesgo alto"
                                       VerticalOptions="Center"
                                       FontSize="13"
                                       TextColor="#30343B" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Grid.Column="1"
                                                   Spacing="8">
                                <Label Text="🟡"
                                       FontSize="22" />
                                <Label Text="Riesgo medio"
                                       VerticalOptions="Center"
                                       FontSize="13"
                                       TextColor="#30343B" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Grid.Row="1"
                                                   Spacing="8">
                                <Label Text="🟢"
                                       FontSize="22" />
                                <Label Text="Riesgo bajo"
                                       VerticalOptions="Center"
                                       FontSize="13"
                                       TextColor="#30343B" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Grid.Row="1"
                                                   Grid.Column="1"
                                                   Spacing="8">
                                <Label Text="⚪"
                                       FontSize="22" />
                                <Label Text="Sin datos"
                                       VerticalOptions="Center"
                                       FontSize="13"
                                       TextColor="#30343B" />
                            </HorizontalStackLayout>

                        </Grid>

                        <Label Text="Los indicadores representan el nivel de riesgo académico calculado para cada estudiante."
                               FontSize="11"
                               TextColor="#8490A3" />

                    </VerticalStackLayout>
                </Border>

                <!-- MENSAJE -->
                <Label Text="{Binding Mensaje}"
                       FontSize="13"
                       TextColor="#269B50"
                       Margin="4,0" />

                <!-- GUARDAR -->
                <Button Text="✓   Guardar asistencia"
                        Command="{Binding GuardarCommand}"
                        BackgroundColor="#D9363E"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="52"
                        Margin="0,0,0,10" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>


