<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="RegistroAsistencia.Views.AsistenciaPage">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="10">

            <Label
                Text="H3 - Registro de asistencia"
                FontSize="24"
                FontAttributes="Bold" />

            <Label
                Text="Alumno seleccionado" />

            <Picker
                Title="Seleccionar alumno"
                ItemsSource="{Binding Estudiantes}"
                SelectedItem="{Binding AlumnoSeleccionado}" />

            <DatePicker
                Date="{Binding FechaClase}" />

            <Button
                Text="Presente"
                Command="{Binding RegistrarPresenteCommand}"
                BackgroundColor="LightGreen" />

            <Button
                Text="Ausente"
                Command="{Binding RegistrarAusenteCommand}"
                BackgroundColor="LightCoral" />

            <Label
                Text="{Binding Mensaje}"
                FontAttributes="Bold" />

            <Label
                Text="Asistencias registradas"
                FontSize="18"
                FontAttributes="Bold" />

            <CollectionView
                ItemsSource="{Binding Asistencias}">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Frame
                            Margin="0,5"
                            Padding="10">

                            <VerticalStackLayout>

                                <Label
                                    Text="{Binding Estudiante}" />

                                <Label
                                    Text="{Binding Clase.Fecha}" />

                                <Label
                                    Text="{Binding Estado}" />

                            </VerticalStackLayout>

                        </Frame>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>