<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RegistroAsistencia.Views.AlumnoFormPage"
             Title="{Binding Titulo}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label Text="Apellido" />
            <Entry Text="{Binding Apellido}" />

            <Label Text="Nombre" />
            <Entry Text="{Binding Nombre}" />

            <Label Text="Legajo" />
            <Entry Text="{Binding Legajo}"
                   IsEnabled="{Binding LegajoEditable}" />

            <Label Text="Comisión" />
            <Picker ItemsSource="{Binding Comisiones}"
                    SelectedItem="{Binding ComisionSeleccionada}" />

            <Label Text="{Binding Mensaje}" Style="{StaticResource Aviso}" />

            <Button Text="{Binding TextoBoton}" Command="{Binding GuardarCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
