<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RegistroAsistencia.Views.ConfigRiesgoPage"
             Title="Cálculo de riesgo">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8">

            <Label Text="{Binding Comision}" Style="{StaticResource TituloPagina}" />
            <Label Text="Estos valores valen solo para esta comisión. Todos son porcentajes de 0 a 100."
                   Style="{StaticResource TextoSecundario}" />

            <Label Text="Peso de la asistencia (el resto es el peso de las entregas)" Margin="0,10,0,0" />
            <Entry Text="{Binding PesoAsistencia}" Keyboard="Numeric" />

            <Label Text="Riesgo de una entrega fuera de término" />
            <Entry Text="{Binding RiesgoFueraDeTermino}" Keyboard="Numeric" />

            <Label Text="Riesgo de una entrega no entregada" />
            <Entry Text="{Binding RiesgoNoEntregado}" Keyboard="Numeric" />

            <Label Text="Desde qué porcentaje el riesgo es medio" />
            <Entry Text="{Binding RiesgoMedio}" Keyboard="Numeric" />

            <Label Text="Desde qué porcentaje el riesgo es alto" />
            <Entry Text="{Binding RiesgoAlto}" Keyboard="Numeric" />

            <Label Text="{Binding Mensaje}" Style="{StaticResource Mensaje}" />

            <Button Text="Guardar configuración" Command="{Binding GuardarCommand}" />
            <Button Text="Volver a los valores por defecto" Command="{Binding RestablecerCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
