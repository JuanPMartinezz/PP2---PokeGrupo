<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="RegistroAsistencia.Views.ConfigRiesgoPage"
    Title="Cálculo de riesgo"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#E9EDF3">

    <Grid RowDefinitions="Auto,*">

        <!-- Encabezado -->
        <VerticalStackLayout Grid.Row="0" Spacing="0">
            <Grid BackgroundColor="#C92532"
                  Padding="24,12"
                  ColumnDefinitions="65,*,Auto"
                  ColumnSpacing="15">

                <Image Grid.Column="0"
                       Source="pokeball.png"
                       HeightRequest="58"
                       WidthRequest="58"
                       Aspect="AspectFit"
                       VerticalOptions="Center"/>

                <VerticalStackLayout Grid.Column="1"
                                     VerticalOptions="Center"
                                     Spacing="2">
                    <Label Text="Registro de asistencia"
                           FontSize="25"
                           FontAttributes="Bold"
                           TextColor="White"/>
                    <Label Text="P O K E G R U P O"
                           FontSize="10"
                           CharacterSpacing="2"
                           TextColor="#FFE2E2"/>
                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Column="2"
                                       Spacing="12"
                                       VerticalOptions="Center"
                                       Margin="10,0,8,0">
                    <Border WidthRequest="30"
                            HeightRequest="30"
                            BackgroundColor="#39C9F2"
                            Stroke="#252B35"
                            StrokeThickness="2"
                            StrokeShape="Ellipse"/>
                    <Border WidthRequest="30"
                            HeightRequest="30"
                            BackgroundColor="#FFD83D"
                            Stroke="#252B35"
                            StrokeThickness="2"
                            StrokeShape="Ellipse"/>
                    <Border WidthRequest="30"
                            HeightRequest="30"
                            BackgroundColor="#80D83C"
                            Stroke="#252B35"
                            StrokeThickness="2"
                            StrokeShape="Ellipse"/>
                </HorizontalStackLayout>
            </Grid>

            <Grid HeightRequest="8">
                <BoxView BackgroundColor="#252B35"/>
                <BoxView BackgroundColor="#E0444C"
                         HeightRequest="3"
                         VerticalOptions="End"/>
            </Grid>
        </VerticalStackLayout>

        <!-- Contenido -->
        <Grid Grid.Row="1" BackgroundColor="#E9EDF3">

            <Image Source="pokeball_fondo.png"
                   HeightRequest="380"
                   WidthRequest="380"
                   Aspect="AspectFit"
                   Opacity="0.5"
                   HorizontalOptions="End"
                   VerticalOptions="End"
                   TranslationX="110"
                   TranslationY="90"
                   InputTransparent="True"/>

            <ScrollView>
                <VerticalStackLayout Padding="24,20,24,28"
                                     Spacing="16">

                    <!-- Título -->
                    <HorizontalStackLayout Spacing="12"
                                           VerticalOptions="Center">
                        <Image Source="pokeball.png"
                               HeightRequest="38"
                               WidthRequest="38"
                               Aspect="AspectFit"/>

                        <Label Text="Cálculo de riesgo"
                               FontSize="25"
                               FontAttributes="Bold"
                               TextColor="#252B35"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <!-- Comisión -->
                    <Border BackgroundColor="White"
                            Stroke="#D5DCE5"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            Padding="18">

                        <VerticalStackLayout Spacing="6">
                            <Label Text="COMISIÓN EVALUADA"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1"
                                   TextColor="#C92532"/>

                            <Label Text="{Binding Comision}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="#252B35"/>

                            <Label Text="Estos valores se aplican únicamente a esta comisión. Todos son porcentajes de 0 a 100."
                                   FontSize="13"
                                   TextColor="#687383"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Ponderación -->
                    <Border BackgroundColor="White"
                            Stroke="#D5DCE5"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            Padding="18">

                        <VerticalStackLayout Spacing="10">

                            <HorizontalStackLayout Spacing="8"
                               VerticalOptions="Center">
                                <Image Source="pokeball.png"
                                       WidthRequest="22"
                                       HeightRequest="22"
                                       Aspect="AspectFit"/>

                                <Label Text="PONDERACIÓN"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="#252B35"
                                        CharacterSpacing="1"
                                        VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <Label Text="Peso de la asistencia"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#394454"/>

                            <Entry Text="{Binding PesoAsistencia}"
                                   Keyboard="Numeric"
                                   BackgroundColor="#F4F6F9"
                                   TextColor="#252B35"
                                   Placeholder="Porcentaje"
                                   HeightRequest="48"/>

                            <Label Text="El porcentaje restante corresponde al peso de las entregas."
                                   FontSize="12"
                                   TextColor="#687383"/>

                        </VerticalStackLayout>
                    </Border>

                    <!-- Penalizaciones -->
                    <Border BackgroundColor="White"
                           Stroke="#D5DCE5"
                           StrokeThickness="1"
                           StrokeShape="RoundRectangle 14"
                           Padding="18">

                        <VerticalStackLayout Spacing="10">

                            <HorizontalStackLayout Spacing="8"
                               VerticalOptions="Center">
                                <Image Source="pokeball.png"
                                    WidthRequest="22"
                                    HeightRequest="22"
                                    Aspect="AspectFit"/>

                                <Label Text="PENALIZACIONES"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="#252B35"
                                        CharacterSpacing="1"
                                        VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <Label Text="Riesgo de una entrega fuera de término"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="#394454"/>

                            <Entry Text="{Binding RiesgoFueraDeTermino}"
                                   Keyboard="Numeric"
                                   BackgroundColor="#F4F6F9"
                                   TextColor="#252B35"
                                   Placeholder="Porcentaje"
                                   HeightRequest="48"/>

                            <Label Text="Riesgo de una entrega no entregada"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#394454"/>

                            <Entry Text="{Binding RiesgoNoEntregado}"
                                   Keyboard="Numeric"
                                   BackgroundColor="#F4F6F9"
                                   TextColor="#252B35"
                                   Placeholder="Porcentaje"
                                   HeightRequest="48"/>

                        </VerticalStackLayout>
                    </Border>

                    <!-- Umbrales -->
                    <Border BackgroundColor="White"
                            Stroke="#D5DCE5"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            Padding="18">

                        <VerticalStackLayout Spacing="10">
                            <HorizontalStackLayout Spacing="8"
                              VerticalOptions="Center">
                                <Image Source="pokeball.png"
                                  WidthRequest="22"
                                  HeightRequest="22"
                                  Aspect="AspectFit"/>
                                <Label Text="RIESGO"
                                      FontSize="13"
                                      FontAttributes="Bold"
                                      TextColor="#252B35"
                                      CharacterSpacing="1"
                                      VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <Label Text=" 🟡 Riesgo medio"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#B88713"/>

                            <Label Text="Desde qué porcentaje se considera riesgo medio."
                                   FontSize="12"
                                   TextColor="#687383"/>

                            <Entry Text="{Binding RiesgoMedio}"
                                   Keyboard="Numeric"
                                   BackgroundColor="#F4F6F9"
                                   TextColor="#252B35"
                                   Placeholder="Porcentaje"
                                   HeightRequest="48"/>

                            <BoxView HeightRequest="1"
                                     BackgroundColor="#E3E7ED"
                                     Margin="0,5"/>

                            <Label Text=" 🔴 Riesgo alto"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#C92532"/>

                            <Label Text="Desde qué porcentaje se considera riesgo alto."
                                   FontSize="12"
                                   TextColor="#687383"/>

                            <Entry Text="{Binding RiesgoAlto}"
                                   Keyboard="Numeric"
                                   BackgroundColor="#F4F6F9"
                                   TextColor="#252B35"
                                   Placeholder="Porcentaje"
                                   HeightRequest="48"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Mensaje -->
                    <Border BackgroundColor="White"
                            Stroke="#D5DCE5"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="14">
                        <Label Text="{Binding Mensaje}"
                               Style="{StaticResource Mensaje}"/>
                    </Border>

                    <!-- Acciones -->
                    <VerticalStackLayout Spacing="10">

                        <Button Text="Guardar configuración"
                                Command="{Binding GuardarCommand}"
                                BackgroundColor="#D9363E"
                                TextColor="White"
                                FontSize="15"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HeightRequest="52"
                                BorderColor="#991F29"
                                BorderWidth="1"/>

                        <Button Text="Volver a los valores por defecto"
                                Command="{Binding RestablecerCommand}"
                                BackgroundColor="#687383"
                                TextColor="White"
                                FontSize="14"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HeightRequest="48"/>

                        <Label Text="⚠️ Al restablecer, se borrarán las configuraciones personalizadas de esta comisión y se recuperarán los valores predeterminados."
                               FontSize="12"
                               TextColor="#A83232"
                               HorizontalTextAlignment="Center"
                               Margin="4,2,4,0"/>

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>