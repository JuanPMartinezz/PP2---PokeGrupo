<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="RegistroAsistencia.MainPage"
    Title="H1 - Nómina de estudiantes">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="10">

            <Label
                Text="H1 - Nómina de estudiantes"
                FontSize="24"
                FontAttributes="Bold" />

            <!-- Selección de comisión -->

            <Label
                Text="Comisión"
                FontAttributes="Bold" />

            <Picker
                Title="Seleccionar comisión"
                ItemsSource="{Binding Comisiones}"
                SelectedItem="{Binding ComisionSeleccionada, Mode=TwoWay}" />

            <!-- Registro -->

            <Label
                Text="Registrar estudiante"
                FontSize="20"
                FontAttributes="Bold"
                Margin="0,10,0,0" />

            <Entry
                Placeholder="Nombre"
                Text="{Binding Nombre, Mode=TwoWay}" />

            <Entry
                Placeholder="Apellido"
                Text="{Binding Apellido, Mode=TwoWay}" />

            <Entry
                Placeholder="Legajo"
                Text="{Binding Legajo, Mode=TwoWay}" />

            <Button
                Text="Agregar alumno"
                Command="{Binding AgregarAlumnoCommand}" />

            <Label
                Text="{Binding Mensaje}"
                TextColor="Red" />

            <!-- Nómina -->

            <Label
                Text="{Binding ComisionSeleccionada,
                StringFormat='Nómina - {0}'}"
                FontSize="20"
                FontAttributes="Bold"
                Margin="0,10,0,0" />

            <Label
                Text="{Binding CantidadAlumnos,
                StringFormat='Cantidad de alumnos: {0}'}"
                FontAttributes="Bold" />

            <CollectionView
                ItemsSource="{Binding Estudiantes}"
                SelectionMode="None">

                <CollectionView.EmptyView>

                    <Label
                        Text="No hay estudiantes registrados en esta comisión."
                        TextColor="Gray"
                        HorizontalTextAlignment="Center"
                        Margin="0,20" />

                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Margin="0,5"
                            Padding="10"
                            Stroke="LightGray"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="3">

                                <Label
                                    Text="{Binding Apellido}"
                                    FontAttributes="Bold"
                                    FontSize="18" />

                                <Label
                                    Text="{Binding Nombre}" />

                                <Label
                                    Text="{Binding Legajo,
                                    StringFormat='Legajo: {0}'}" />

                                <Label
                                    Text="{Binding Comision,
                                    StringFormat='Comisión: {0}'}"
                                    TextColor="Gray" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

            <Button
                Text="Ir a H3 - Registro de asistencia"
                Clicked="IrAH3_Clicked"
                Margin="0,10,0,0" />

            <Button
                Text="Borrar todos los datos"
                BackgroundColor="Red"
                TextColor="White"
                Clicked="BorrarTodo_Clicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>