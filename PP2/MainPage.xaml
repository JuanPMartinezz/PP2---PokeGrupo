<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RegistroAsistencia.MainPage"
             Title="Registro de asistencia">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Comisiones" Style="{StaticResource TituloPagina}" />

            <Label Text="Todavía no hay comisiones. Agregá una para empezar."
                   Style="{StaticResource TextoSecundario}"
                   IsVisible="{Binding SinComisiones}" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Comisiones}" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Tarjeta}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Abrir}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Nombre}" FontSize="20" FontAttributes="Bold" />
                                <Label Text="{Binding Detalle}" Style="{StaticResource TextoSecundario}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button Text="Agregar otra comisión"
                    Margin="0,10,0,0"
                    Command="{Binding NuevaComisionCommand}" />

            <Button Text="Agregar alumno nuevo"
                    Command="{Binding NuevoAlumnoCommand}" />

            <Button Text="Administrar datos"
                    Margin="0,40,0,0"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Gray500}"
                    Command="{Binding AdministrarCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
